{
  "name": "upgraditch-counts",
  "version": "0.1.0",
  "private": true,
  "description": "Counts endpoint for Upgraditch's opt-in field study",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create upgraditch-counts",
    "db:schema": "wrangler d1 execute upgraditch-counts --remote --file schema.sql",
    "db:schema:local": "wrangler d1 execute upgraditch-counts --local --file schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  }
}
